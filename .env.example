# ─── Postgres ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_champions

# ─── Microsoft Entra (Azure AD) — required in non-dev environments ─────────
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=
AUTH_SECRET=replace-with-openssl-rand-base64-32

# ─── Public base URL (used in nudge emails, callbacks, PDF footers) ────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Microsoft Group URL for the Champions community (linked from /admin) ──
CHAMPIONS_GROUP_URL=

# ─── Dev auth bypass — NEVER enable in production ──────────────────────────
DEV_AUTH_BYPASS=true
DEV_AUTH_USER_EMAIL=team@example.test
DEV_AUTH_USER_NAME=Dev Lead
DEV_AUTH_USER_ROLES=Champion,AITeam,Admin

# ─── File storage backend: local | azure ───────────────────────────────────
STORAGE_BACKEND=local
# Azure Blob (when STORAGE_BACKEND=azure)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=artifacts

# ─── Email backend: log | smtp | graph ─────────────────────────────────────
EMAIL_BACKEND=log
# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Graph send-as (preferred in prod): the mailbox to send from
GRAPH_SEND_AS=

# ─── Scheduled jobs ────────────────────────────────────────────────────────
# Comma-separated emails CC'd on weekly nudge messages
NUDGE_CC=
# Comma-separated emails CC'd when an approval breaches SLA
SLA_ESCALATION_CC=

# ─── SharePoint importer (one-time cutover) ────────────────────────────────
SP_SITE=
SP_LIST=Project Backlog
GRAPH_TENANT=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
