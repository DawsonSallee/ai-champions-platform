{
  "name": "ai-champions-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/web",
    "dev:embedded": "tsx scripts/dev-embedded.ts",
    "build": "next build apps/web",
    "start": "next start apps/web",
    "lint": "next lint apps/web",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config=apps/web/drizzle.config.ts",
    "db:migrate": "tsx apps/web/src/db/migrate.ts",
    "db:seed": "tsx apps/web/src/db/seed/index.ts",
    "db:bootstrap": "tsx apps/web/src/db/seed/bootstrap.ts",
    "db:studio": "drizzle-kit studio --config=apps/web/drizzle.config.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "job:nudge": "tsx scripts/nudge-active-projects.ts",
    "job:sla-check": "tsx scripts/sla-breach-check.ts",
    "import:sharepoint": "tsx scripts/import-from-sharepoint.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.31.0",
    "@electric-sql/pglite": "^0.4.5",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-table": "^8.20.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.4",
    "next": "15.0.3",
    "next-auth": "^5.0.0-beta.31",
    "nextjs-toploader": "^3.7.15",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
